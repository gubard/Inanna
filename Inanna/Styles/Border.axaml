<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}"/>
    </Style>

    <Style Selector="Border.cr-5">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="Border.for-drop">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    </Style>

    <Style Selector="Border.item">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background"
                Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>

    <Style Selector="Border.status">
        <Setter Property="BorderThickness" Value="5,0,0,0" />
    </Style>

    <Style Selector="Border.trace">
        <Setter Property="BorderBrush" Value="DarkGray" />
    </Style>

    <Style Selector="Border.debug">
        <Setter Property="BorderBrush" Value="Cyan" />
    </Style>

    <Style Selector="Border.information">
        <Setter Property="BorderBrush" Value="Green" />
    </Style>

    <Style Selector="Border.warning">
        <Setter Property="BorderBrush" Value="Yellow" />
    </Style>

    <Style Selector="Border.error">
        <Setter Property="BorderBrush" Value="DarkRed" />
    </Style>

    <Style Selector="Border.critical">
        <Setter Property="BorderBrush" Value="Red" />
    </Style>
</Styles>