<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Inanna.Controls">
    <ControlTheme x:Key="NotificationControlStyle" TargetType="c:NotificationControl">
        <Setter Property="Width" Value="300" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Width="{TemplateBinding Width}"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource NotificationCardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="5,0,0,0" />
        </Style>

        <Style Selector="^:info /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardInformationBackgroundBrush}" />
        </Style>

        <Style Selector="^:error /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardErrorBackgroundBrush}" />
        </Style>

        <Style Selector="^:progress /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardProgressBackgroundBrush}" />
        </Style>

        <Style Selector="^:success /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardSuccessBackgroundBrush}" />
        </Style>

        <Style Selector="^:warning /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardWarningBackgroundBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:NotificationControl}"
                  BasedOn="{StaticResource NotificationControlStyle}"
                  TargetType="c:NotificationControl" />
</ResourceDictionary>