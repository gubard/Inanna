<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Inanna.Helpers"
        xmlns:s="clr-namespace:System;assembly=System.Runtime"
        xmlns:ip="https://github.com/MahApps/IconPacks.Avalonia">
    <Style Selector="TextBox">
        <Setter Property="Margin" Value="5" />
        <Setter Property="InnerRightContent">
            <Template>
                <StackPanel Orientation="Horizontal">
                    <Button Classes="mini show-password-button"
                            h:ButtonAssist.IsPasswordHandler="True" />
                    <Button Classes="mini show-select-all-button"
                            Content="{ip:MaterialDesign SelectAll}"
                            h:ButtonAssist.IsSelectAllHandler="True" />
                    <Button Classes="mini show-clear-all-button"
                            Content="{ip:MaterialDesign Clear}"
                            h:ButtonAssist.IsClearAllHandler="True" />
                </StackPanel>
            </Template>
        </Setter>
    </Style>

    <Style Selector="TextBox Button.show-select-all-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox Button.show-password-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox Button.show-clear-all-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox.password Button.show-password-button">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="TextBox.clear-all Button.show-clear-all-button">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    
    <Style Selector="TextBox.content-align-center">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.select-all Button.show-select-all-button">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="TextBox.is-readonly">
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style Selector="TextBox.text-aria">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>

    <Style Selector="TextBox.plain-text">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TextBox.plain-text:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBox.plain-text:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.plain-text:focus">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.password">
        <Setter Property="PasswordChar" Value="*" />
    </Style>

    <Style Selector="TextBox:show-password">
        <Setter Property="PasswordChar" Value="*" />
    </Style>

    <Style Selector="TextBox:hide-password">
        <Setter Property="PasswordChar" Value="{x:Static s:Char.MinValue}" />
    </Style>

    <Style Selector="TextBox.plain-text Button.show-password-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox.plain-text Button.show-clear-all-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox.plain-text Button.show-select-all-button">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>