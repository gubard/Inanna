<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Inanna.Converters">
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    
    <Style Selector="ListBox.multiple">
        <Setter Property="SelectionMode" Value="Multiple" />
    </Style>
    
    <Style Selector="ListBox.enum">
        <Setter Property="ItemsSource" Value="{Binding $self.SelectedItem, Converter={x:Static c:EnumValueToValuesConverter.Instance}}" />
    </Style>
</Styles>