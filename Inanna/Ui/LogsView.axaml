<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Inanna.Ui"
             xmlns:is="clr-namespace:Inanna.Services"
             xmlns:hm="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Inanna.Ui.LogsView"
             x:DataType="ui:LogsViewModel">
    <ItemsControl ItemsSource="{Binding Logs}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Classes="item">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto, Auto,*">
                        <Rectangle Grid.RowSpan="2"
                                   Classes="w-5"
                                   Classes.trace="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Trace}}"
                                   Classes.debug="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Debug}}"
                                   Classes.information="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Information}}"
                                   Classes.warning="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Warning}}"
                                   Classes.error="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Error}}"
                                   Classes.critical="{Binding Level, Converter={x:Static is:IsValueConverter.Instance}, ConverterParameter={x:Static hm:LogLevel.Critical}}" />
                        <TextBlock Grid.Column="1"
                                   Classes="align-center m-2"
                                   Text="{Binding DateTime.LocalDateTime.Date, StringFormat={}{0:dd.MM.yyyy}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Classes="align-center m-2"
                                   Text="{Binding DateTime.LocalDateTime.TimeOfDay, StringFormat={}{0:hh\\:mm}}" />
                        <TextBlock Grid.Column="2"
                                   Grid.RowSpan="2"
                                   Classes="text-wrap align-left-center m-2"
                                   Text="{Binding Text}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>